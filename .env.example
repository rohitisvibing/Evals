# --- Supabase (public values; safe in the browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-or-publishable-key>
# Used for OAuth redirects (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server-only secrets (never prefix with NEXT_PUBLIC_) ---
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
OPENROUTER_API_KEY=<openrouter-key>
TYPESAFE_API_KEY=<typesafe-key>
# Comma-separated, verified-email allowlist for the quota exemption
ADMIN_EMAILS=admin@example.com
# Random string used to hash client IPs for throttling
IP_HASH_SALT=<random-string>

# --- Local-only login bypass: set DEV_LOGIN=1 for local dev. Ignored for hosted Supabase or on Vercel. ---
DEV_LOGIN=
DEV_LOGIN_EMAIL=

# --- Models (explicit; there is no automatic fallback) ---
JEV_MODEL=jev-1.14.0
JUDGE_MODEL=google/gemma-4-31b-it
# json_schema = strict structured outputs (model must support it); json_object = JSON mode
JUDGE_RESPONSE_FORMAT=json_schema
# Route only to full-precision hosts of the same model (comma-separated; empty = any)
JUDGE_QUANTIZATIONS=bf16,fp8
EMBEDDING_MODEL=baai/bge-m3
# RAG answer generator (QA mode). Kept a different model family from the judge.
ANSWER_MODEL=openai/gpt-4.1-nano
# USD per 1M tokens, used for cost estimates when the provider does not report cost
JUDGE_PRICE_INPUT_PER_MTOK=0.20
JUDGE_PRICE_OUTPUT_PER_MTOK=0.40
ANSWER_PRICE_INPUT_PER_MTOK=0.10
ANSWER_PRICE_OUTPUT_PER_MTOK=0.40
EMBEDDING_PRICE_PER_MTOK=0.01
JEV_PRICE_INPUT_PER_MTOK=0.042

# --- Google OAuth (only for `supabase start` locally; hosted projects use the dashboard) ---
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
